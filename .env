# ==============================================
# Frontend - LiveGo (Vite / React)
# ==============================================

# --- Ambiente ---
VITE_USE_REAL_APIS=true

# --- URL da API do Backend ---
# Desenvolvimento local: deixe vazio para usar o proxy do Vite (recomendado)
# Produção: coloque a URL completa do backend, ex: https://api.livego.store
VITE_API_BASE_URL=

# --- URL do Backend (para conexões diretas fora do proxy) ---
VITE_BACKEND_URL=http://localhost:3000

# --- WebSocket ---
VITE_SOCKET_URL=http://localhost:3001
